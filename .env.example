NLP_TDA_PORT=38417
NLP_TDA_USE_HASH_EMBEDDINGS=true
NLP_TDA_FORCE_MOCK_LLM=true
# Docker Desktop / Linux with host-gateway:
# NLP_TDA_OLLAMA_BASE_URL=http://host.docker.internal:11434
# The ollama service in docker-compose.yml (default):
NLP_TDA_OLLAMA_BASE_URL=http://ollama:11434
NLP_TDA_OLLAMA_MODEL=qwen2.5:7b
# Access: the port is published on 127.0.0.1 only. For other machines set both of these
# (and put TLS in front; HTTP Basic auth is not encrypted):
# NLP_TDA_BIND=0.0.0.0
# NLP_TDA_AUTH_PASSWORD=
